---
/** Core plugin features. Icons are inline stroke SVG paths. */
const features = [
  {
    title: 'Virtual folders',
    body: 'Create nested, hierarchical folders to organize media any way you like.',
    path: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  },
  {
    title: 'Drag & drop',
    body: 'Move media between folders with a drag — or bulk-move many at once.',
    path: '<path d="M12 3v12"/><path d="m8 11 4 4 4-4"/><rect x="4" y="17" width="16" height="4" rx="1"/>',
  },
  {
    title: 'Gutenberg integration',
    body: 'Filter media by folder right inside the block editor’s media modal.',
    path: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>',
  },
  {
    title: 'Fast folder search',
    body: 'Jump to any folder instantly; matching subfolders expand automatically.',
    path: '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
  },
  {
    title: 'Fully keyboard accessible',
    body: 'Complete keyboard navigation and screen-reader support, by design.',
    path: '<rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M7 14h10"/>',
  },
  {
    title: 'Lightweight & private',
    body: 'Uses native WordPress taxonomy. No tracking, no cookies, no bloat.',
    path: '<path d="M12 3l7 4v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V7z"/><path d="m9 12 2 2 4-4"/>',
  },
];
---

<section id="features" class="section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Features</span>
      <h2>Everything you need to tame your media.</h2>
      <p>Powerful where it counts, invisible everywhere else.</p>
    </div>

    <div class="grid features-grid">
      {
        features.map((f) => (
          <article class="card feature">
            <span class="feature-ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={f.path} />
            </span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features-grid {
    grid-template-columns: 1fr;
  }
  .feature {
    padding: 1.6rem;
  }
  .feature-ico {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .feature-ico svg {
    width: 24px;
    height: 24px;
  }
  .feature h3 {
    margin-bottom: 0.4rem;
  }
  .feature p {
    color: var(--text-muted);
  }
  @media (min-width: 620px) {
    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 920px) {
    .features-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
